<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="UseDataStatistics.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(CommonLibRoot)Reservation\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(CommonLibRoot)Reservation\lib\x64\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Reservation.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>if "$(ConfigurationType)"=="Application" copy /Y "$(CommonLibRoot)Reservation\bin\x64\$(Configuration)\Reservation.dll" "$(TargetDir)"
%(PostBuildEvent.Command)</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>
